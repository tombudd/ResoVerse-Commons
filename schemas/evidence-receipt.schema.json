{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tombudd/ResoVerse-Commons/main/schemas/evidence-receipt.schema.json",
  "title": "ResoVerse Commons Validation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "status",
    "canonicalManifestSha256",
    "submittedBytesSha256",
    "reasonCodes",
    "executionAttempted",
    "memoryPromotionAuthorized",
    "productionActivationAuthorized"
  ],
  "properties": {
    "receiptVersion": {"const": "1.0"},
    "status": {"enum": ["PASS", "HOLD"]},
    "canonicalManifestSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "submittedBytesSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "reasonCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "executionAttempted": {"const": false},
    "memoryPromotionAuthorized": {"const": false},
    "productionActivationAuthorized": {"const": false}
  }
}

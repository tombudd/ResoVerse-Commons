{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tombudd/ResoVerse-Commons/main/schemas/bundle-receipt.schema.json",
  "title": "ResoVerse Commons Bundle Validation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleReceiptVersion", "status", "bundleBytesSha256", "reasonCodes", "executionAttempted", "admissionAuthorized"],
  "properties": {
    "bundleReceiptVersion": {"const": "1.0"},
    "status": {"enum": ["PASS", "HOLD"]},
    "bundleBytesSha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "executionAttempted": {"const": false},
    "admissionAuthorized": {"const": false}
  }
}
